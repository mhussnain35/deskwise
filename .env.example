# ---------------------------------------------------------------------------
# OpenRouter — serves both chat and embeddings from one key.
# Get a key at https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Chat model. Browse current ids at https://openrouter.ai/models — ids are
# retired over time, and a stale one fails with "No endpoints found for <id>".
# Models with a ":free" suffix need no credit balance.
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Embedding model. https://openrouter.ai/collections/embedding-models
# These are all paid (fractions of a cent for this project's volume).
# text-embedding-3-small supports dimension truncation, so it can match the
# 768-wide Qdrant collection this project ships with.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional attribution shown on OpenRouter's public leaderboards
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Deskwise

# ---------------------------------------------------------------------------
# Embedding width. MUST match the Qdrant collection.
#
# A vector is only comparable to vectors from the *same model*. Change the
# embedding model or this value and every stored vector becomes meaningless —
# nothing errors, similarity just collapses and the agent refuses every
# question. After changing either:
#   npx tsx scripts/provider-check.ts   # confirm the model's real width
#   (delete the Qdrant collection if the width changed)
#   npx tsx scripts/ingest.ts           # re-embed the knowledge base
#   npx tsx scripts/reembed.ts          # re-embed documents users uploaded
# ---------------------------------------------------------------------------
EMBEDDING_DIMENSION=768

# --- Data stores ------------------------------------------------------------

# Neon Postgres connection string — get one free at https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Qdrant Cloud (optional — local cosine similarity fallback is used if not set)
# Create a free cluster at https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# --- Retrieval tuning -------------------------------------------------------

# Dense weight in hybrid retrieval: 1 = pure vector, 0 = pure keyword
HYBRID_ALPHA=0.7

# Similarity a knowledge base chunk must reach before the agent will answer
# from it. Below this the agent escalates to a human instead of guessing.
CONFIDENCE_THRESHOLD=0.55

# The same gate for a document the user uploaded themselves. Deliberately
# lower: they attached the file and asked about it, so refusing is almost
# always the wrong call.
USER_DOC_CONFIDENCE_THRESHOLD=0.35

# --- Admin ------------------------------------------------------------------

# Shared secret guarding the admin write endpoints (/api/admin/docs POST,
# /api/admin/reindex). These mutate the model's grounding context and trigger a
# full re-embed, so they must not be left open.
#   unset + local dev  → endpoints open (demo convenience)
#   unset + production → endpoints disabled (503)
#   set                → x-admin-token header required
ADMIN_TOKEN=generate_a_long_random_string
