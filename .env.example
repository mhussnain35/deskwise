# Gemini API Key — get one free at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Neon Postgres connection string — get one free at https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Qdrant Cloud (optional — local cosine similarity fallback is used if not set)
# Create a free cluster at https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
