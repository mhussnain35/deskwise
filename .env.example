# ---------------------------------------------------------------------------
# AI providers
#
# "openrouter" (OpenAI-compatible, one key for hundreds of models) or "gemini"
# (Google's API directly). Leave AI_PROVIDER unset to infer it from whichever
# key is present — OpenRouter wins if both are.
#
# Generation and embeddings are resolved separately, because the cheapest source
# for each is rarely the same vendor. A combination that works on free tiers:
#   AI_PROVIDER=openrouter        chat on a ":free" model
#   EMBEDDING_PROVIDER=gemini     embeddings free, and 768-d to match Qdrant
# EMBEDDING_PROVIDER defaults to AI_PROVIDER when unset.
# ---------------------------------------------------------------------------
AI_PROVIDER=openrouter
EMBEDDING_PROVIDER=gemini

# --- OpenRouter (https://openrouter.ai/keys) --------------------------------
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Chat model. Browse current ids at https://openrouter.ai/models — ids are
# retired over time, and a stale one fails with "No endpoints found for <id>".
# Models with a ":free" suffix need no credit balance.
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Embedding model, used only when EMBEDDING_PROVIDER=openrouter.
# https://openrouter.ai/collections/embedding-models — all are paid, so this
# needs a funded account. text-embedding-3-small supports dimension truncation
# and can therefore match the 768-wide Qdrant collection.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional attribution shown on OpenRouter's public leaderboards
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Deskwise

# --- Gemini (https://aistudio.google.com) -----------------------------------
# Model ids are the API id (lowercase, hyphenated) — not the display name shown
# in the AI Studio UI. "Gemini 2.5 Flash Lite" is not an id; the id is
# "gemini-2.5-flash-lite".
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---------------------------------------------------------------------------
# Embedding width. MUST match the Qdrant collection.
#
# Changing the embedding model or this value invalidates every stored vector —
# they are only comparable to vectors from the same model. Nothing errors when
# they mismatch; similarity just collapses and the agent escalates everything.
# After changing either: delete the Qdrant collection, then re-run
#   npx tsx scripts/ingest.ts
# Verify your model's real width first with:
#   npx tsx scripts/provider-check.ts
# ---------------------------------------------------------------------------
EMBEDDING_DIMENSION=768

# --- Data stores ------------------------------------------------------------

# Neon Postgres connection string — get one free at https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Qdrant Cloud (optional — local cosine similarity fallback is used if not set)
# Create a free cluster at https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# --- Retrieval tuning -------------------------------------------------------

# Dense weight in hybrid retrieval: 1 = pure vector, 0 = pure keyword
HYBRID_ALPHA=0.7

# --- Admin ------------------------------------------------------------------

# Shared secret guarding the admin write endpoints (/api/admin/docs POST,
# /api/admin/reindex). These mutate the model's grounding context and trigger a
# full re-embed, so they must not be left open.
#   unset + local dev  → endpoints open (demo convenience)
#   unset + production → endpoints disabled (503)
#   set                → x-admin-token header required
ADMIN_TOKEN=generate_a_long_random_string
