# Gemini API Key — get one free at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Neon Postgres connection string — get one free at https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Qdrant Cloud (optional — local cosine similarity fallback is used if not set)
# Create a free cluster at https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Shared secret guarding the admin write endpoints (/api/admin/docs POST,
# /api/admin/reindex). These mutate the model's grounding context and trigger a
# full re-embed, so they must not be left open.
#   unset + local dev  → endpoints open (demo convenience)
#   unset + production → endpoints disabled (503)
#   set                → x-admin-token header required
ADMIN_TOKEN=generate_a_long_random_string

# Generation model. Override when your key has no free-tier quota for the
# default (a permanent 429 with "limit: 0"). gemini-flash-latest is a good
# alternative to gemini-2.0-flash.
GEMINI_MODEL=gemini-2.0-flash
